{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workorajobs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "2794d92e236a4d22a0e2b42118d5ee86"
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets"
  },
  "env": {
    "preview": {
      "name": "workorajobs-preview"
    }
  }
}
