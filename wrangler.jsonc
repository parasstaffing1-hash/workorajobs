{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workora-jobs-worker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": ".next",
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "workora-hyperdrive-db",
      "localConnectionString": "postgresql://postgres:Supernoddy1%40@db.jayggxfyztajmtwmzxlb.supabase.co:5432/postgres"
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets"
  },
  "env": {
    "preview": {
      "name": "workora-jobs-worker-preview"
    }
  }
}
