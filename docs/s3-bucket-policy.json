{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadForPublicFolders",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::YOUR_BUCKET_NAME/profile-images/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/company-logos/*"
      ]
    },
    {
      "Sid": "DenyPublicReadForPrivateFolders",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::YOUR_BUCKET_NAME/resumes/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/certificates/*"
      ],
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/WorkoraJobsEC2Role"
        }
      }
    }
  ]
}
